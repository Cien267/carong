---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import JournalCard from '../../components/JournalCard.astro';
import { catalog } from '../../lib/catalog';

const { brand } = catalog;
const posts = (await getCollection('journal', (p) => !p.data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Layout title={`Nhật ký chuyến đi | ${brand.name}`} description="Ảnh và câu chuyện từ những chuyến đi có mang theo bộ pha cà phê của Cà Rong.">
  <Header name={brand.name} />
  <main class="mx-auto max-w-6xl px-5 py-12 md:py-16">
    <h1 class="font-display text-4xl leading-tight md:text-6xl">Nhật ký chuyến đi</h1>
    <p class="mt-3 max-w-md text-ink/80">Ảnh và câu chuyện từ những chuyến đi có mang theo bộ pha cà phê của Cà Rong.</p>
    {posts.length === 0 ? (
      <p class="stamp mt-10 p-6">Chưa có bài viết nào. Bài đầu tiên sẽ sớm được đăng.</p>
    ) : (
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => <JournalCard slug={p.id} {...p.data} />)}
      </div>
    )}
  </main>
  <Footer brand={brand} />
</Layout>
