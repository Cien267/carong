---
import JournalCard from './JournalCard.astro';
interface Post { id: string; data: { title: string; description: string; date: Date; place: string; cover: { src: string; alt: string } | null } }
interface Props { posts: Post[] }
const { posts } = Astro.props;
---
{posts.length > 0 && (
  <section id="nhat-ky" class="scroll-mt-14 py-12 md:py-16" aria-labelledby="nhat-ky-title">
    <div class="mx-auto max-w-6xl px-5">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 id="nhat-ky-title" class="font-display text-4xl leading-tight md:text-5xl">Nhật ký chuyến đi</h2>
          <p class="mt-2 max-w-md text-ink/80">Ảnh và câu chuyện từ những chuyến đi có mang theo bộ pha cà phê của Cà Rong.</p>
        </div>
        <a href="/nhat-ky" class="btn btn-ghost self-start md:self-auto">Xem tất cả bài viết</a>
      </div>
      <div class="relative mt-8 grid gap-5 md:grid-cols-3">
        {posts.map((p) => <JournalCard slug={p.id} {...p.data} />)}
      </div>
    </div>
  </section>
)}
