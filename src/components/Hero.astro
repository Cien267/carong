---
import type { Brand } from '../lib/schema';
interface Props { brand: Brand; fromPrice: string; comboCount: number; gearCount: number }
const { brand, fromPrice, comboCount, gearCount } = Astro.props;
const stats = [
  { v: String(comboCount).padStart(2, '0'), l: 'gu pha có sẵn' },
  { v: String(gearCount).padStart(2, '0'), l: 'món thuê lẻ' },
  { v: fromPrice, l: 'giá combo / ngày' },
  { v: '0', l: 'món phải mua' },
];
---
<section class="border-b border-dashed border-ink">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 pb-10 pt-10 md:grid-cols-[1.25fr_1fr] md:items-center md:gap-12 md:pb-16 md:pt-16">
    <div>
      <p class="meta">Thuê đồ pha cà phê dã ngoại · {brand.location.city}</p>
      <h1 class="mt-4 font-display text-[clamp(2.6rem,11.5vw,5.75rem)] uppercase leading-[1.12] [text-wrap:balance]">
        {brand.tagline}<span aria-hidden="true" class="ml-1 inline-block size-[0.17em] bg-terra"></span>
      </h1>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-ink/85">
        Bộ kit pha cà phê cho xe máy và lều trại. Thuê theo combo hoặc từng món, trả đồ là xong.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#thue" class="btn btn-primary">Xem combo</a>
        <a href="#do-le" class="btn btn-ghost">Thuê đồ lẻ</a>
      </div>
    </div>

    <div class="relative">
      <img class="ph aspect-[4/5] w-full object-cover" src="/images/hero.jpg" aria-label="Ảnh hero" />
      <p class="stamp absolute -bottom-3 left-3 rotate-[-3deg] bg-kraft px-3 py-2 font-mono text-xs text-terra-dark md:-left-5">
        Hoàn cọc ngay khi trả đồ
      </p>
    </div>
  </div>

  <dl class="mx-auto grid max-w-6xl grid-cols-2 border-t border-dashed border-ink md:grid-cols-4">
    {stats.map((s, i) => (
      <div class={`px-5 py-4 ${i % 2 === 1 ? 'border-l border-dashed border-ink' : ''} ${i > 1 ? 'border-t border-dashed border-ink md:border-t-0' : ''} ${i > 0 ? 'md:border-l md:border-dashed md:border-ink' : ''}`}>
        <dt class="meta order-2">{s.l}</dt>
        <dd class="font-display text-2xl">{s.v}</dd>
      </div>
    ))}
  </dl>
</section>
