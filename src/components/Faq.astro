---
import Icon from './icons/Icon.astro';
interface Props { items: { id: string; question: string; answer: string }[] }
const { items } = Astro.props;
---
<section id="hoi-dap" class="scroll-mt-14 border-y border-dashed border-ink bg-kraft-deep py-12 md:py-16" aria-labelledby="faq-title">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 md:grid-cols-[1fr_1.6fr] md:gap-14">
    <div>
      <h2 id="faq-title" class="font-display text-4xl leading-tight md:text-5xl">Câu hỏi thường gặp</h2>
      <p class="mt-3 max-w-sm text-ink/80">Nếu bạn chưa tìm thấy câu trả lời, cứ nhắn chúng mình qua Zalo hoặc Tiktok nhé.</p>
    </div>
    <div class="divide-y divide-dashed divide-ink border-y border-dashed border-ink">
      {items.map((q) => (
        <details class="group py-1">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-2 font-semibold [&::-webkit-details-marker]:hidden">
            {q.question}
            <Icon name="plus" size={20} class="shrink-0 group-open:hidden" />
            <Icon name="minus" size={20} class="hidden shrink-0 group-open:block" />
          </summary>
          <p class="pb-4 pr-8 leading-relaxed text-ink/85">{q.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
